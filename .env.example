# Copy to .env and adjust. Values here are safe for local development only.
DEBUG=1
SECRET_KEY=dev-insecure-secret-key-change-me
DATABASE_URL=postgres://app:app@localhost:5432/app

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Comma-separated host names added to localhost and 127.0.0.1
ALLOWED_HOSTS=

BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432

# Address the frontend server forwards /api and /media to (docker compose sets http://backend:8000)
BACKEND_URL=http://localhost:8000
